// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude": {

    }
  },
  "terminal": {
    "shell": "system"
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": true
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-5-latest"
    },
    "model_parameters": []
  },
  "confirm_quit": true,
  "use_system_window_tabs": false,
  "edit_predictions": {
    "mode": "subtle"
  },
  "format_on_save": "off",
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "ui_font_family": "ZedMono Nerd Font Propo",
  "buffer_font_family": "ZedMono Nerd Font Propo",
  "theme": "Kanagawa Wave",
  "autosave": "on_focus_change",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "languages": {
    "Swift": {
      "formatter": {
            "external": {
              "command": "swift-format",
              "arguments": ["format", "--in-place"]
            }
          },
      "tab_size": 2
    }
  },
  "lsp": {
    "dart": {
      "binary": {
        "path": "/Users/verticalheretic/.fvm_flutter/bin/fvm",
        "arguments": ["dart", "language-server", "--protocol=lsp"]
      },
      "settings": {
        "lineLength": 140
      }
    },

  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  }
}
