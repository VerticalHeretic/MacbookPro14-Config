{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "hide_hidden": false,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "terminal": {
    "shell": "system",
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": true,
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-5-latest",
    },
    "model_parameters": [],
  },
  "confirm_quit": true,
  "use_system_window_tabs": false,
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
  },
  "format_on_save": "off",
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "ui_font_family": "ZedMono Nerd Font Propo",
  "buffer_font_family": "ZedMono Nerd Font Propo",
  "theme": { "mode": "system", "light": "Azulejo Brutalism Light", "dark": "Azulejo Brutalism Dark" },
  "cursor_animation": {
    "enabled": true
  },
  "autosave": "on_focus_change",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "languages": {
    "Swift": {
      "formatter": {
        "external": {
          "command": "swift-format",
          "arguments": ["format", "--in-place"],
        },
      },
      "tab_size": 2,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
}
